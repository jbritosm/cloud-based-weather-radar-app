# Optional for local development: every value has a default in docker-compose.yml.
# Copy to .env only if you want to override something.
POSTGRES_PASSWORD=tfg
S3_BUCKET=tfg-data
AWS_REGION=eu-west-1

# API keys of the data providers (all free). Never commit real values: in production they come
# from GitHub secrets with the same names (see .github/workflows/README.md).
AEMET_API_KEY=                # https://opendata.aemet.es
EUMETSAT_CONSUMER_KEY=        # https://api.eumetsat.int/api-key  (key + secret pair)
EUMETSAT_CONSUMER_SECRET=
CDS_API_KEY=                  # Copernicus CDS personal access token (your CDS profile page)

# Requests per minute allowed from one client address to the API (0 = unlimited).
# Set it to 0 when load-testing the server itself.
RATE_LIMIT_PER_MINUTE=600

# Worker settings
INGEST_INTERVAL_SECONDS=300
NEXRAD_SITES=KTLX,KOKX
