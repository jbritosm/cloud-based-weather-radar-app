# Optional for local development: every value has a default in docker-compose.yml.
# Copy to .env only if you want to override something.
POSTGRES_PASSWORD=tfg
S3_BUCKET=tfg-data
AWS_REGION=eu-west-1

# AEMET OpenData key (free, https://opendata.aemet.es). Never commit the real value.
# In production it comes from the GitHub secret AEMET_API_KEY.
AEMET_API_KEY=

# Worker settings
INGEST_INTERVAL_SECONDS=300
NEXRAD_SITES=KTLX,KOKX
